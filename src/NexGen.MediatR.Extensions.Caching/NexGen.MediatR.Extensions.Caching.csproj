<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>NexGen.MediatR.Extensions.Caching</Title>
    <Description>MediatR output caching with pipeline behaviors, tag-based invalidation, and in-memory cache support.</Description>
    <PackageTags>Mediator;MediatR;Caching;Cache;Redis;MemoryCache;CQRS;CommandHandler;QueryHandler;MessageBus;EventBus;PubSub;InMemoryCache;DistributedCache;AsyncMessaging;DataCaching;CacheProvider;HighPerformanceCaching;ThreadSafeCache</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NexGen.MediatR.Extensions.Caching.Redis" />
    <InternalsVisibleTo Include="NexGen.MediatR.Extensions.Caching.Garnet" />
    <InternalsVisibleTo Include="NexGen.MediatR.Extensions.Caching.UnitTest" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" />
    <PackageReference Include="FluentResults" />
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

</Project>
